/* ============ GENERIC BUILDERS ============ */
function normalize(s){ return s.toLowerCase().replace(/[.,!?]/g,'').replace(/\s+/g,' ').trim(); }

function buildFill(containerId, items, opts={}){
  const el = document.getElementById(containerId);
  el.innerHTML = items.map((it,i)=>{
    const num = (opts.startAt||1)+i;
    const origLine = it.orig ? `<div class="orig-line" style="width:100%;font-size:13px;color:var(--ink-soft);margin-bottom:2px;">${num}. <i>${it.orig}</i></div>` : '';
    return `<div class="prow" data-i="${i}">
      ${origLine}
      <span class="qn">${it.orig?'':num+'.'}</span>
      <span>${it.before}</span>
      ${it.cap?`<span class="capw">${it.cap}</span>`:''}
      ${it.word?`<span class="capw">${it.word}</span>`:''}
      ${it.wrongWord?`<span class="wrongw">${it.wrongWord}</span>`:''}
      <input type="text" placeholder="${opts.placeholder||'type answer'}">
      <span>${it.after||''}</span>
      <span class="reveal"></span>
    </div>`;
  }).join('');
}
function checkFill(containerId, items, scoreId){
  const el = document.getElementById(containerId); let score=0;
  el.querySelectorAll('.prow').forEach((row,i)=>{
    const it = items[i]; const input = row.querySelector('input');
    const ok = it.ans.some(a=> normalize(a)===normalize(input.value));
    input.classList.remove('correct','incorrect'); input.classList.add(ok?'correct':'incorrect');
    const reveal = row.querySelector('.reveal');
    if(!ok){ reveal.style.display='inline'; reveal.textContent='→ '+it.ans[0]; } else { reveal.style.display='none'; }
    if(ok) score++;
  });
  document.getElementById(scoreId).textContent = `Score: ${score} / ${items.length}`;
}

function buildMCQ(containerId, items){
  const el = document.getElementById(containerId);
  el.innerHTML = items.map((it,i)=>`
    <div class="mcq-item" data-i="${i}">
      <div class="mcq-q"><span class="qn">${i+1}.</span>${it.t}</div>
      <div class="mcq-opts">${it.o.map((o,oi)=>`<button data-oi="${oi}">${String.fromCharCode(65+oi)}. ${o}</button>`).join('')}</div>
    </div>`).join('');
  el.querySelectorAll('.mcq-item').forEach((itemEl,i)=>{
    itemEl.querySelectorAll('.mcq-opts button').forEach((btn,oi)=>{
      btn.addEventListener('click', ()=>{
        itemEl.querySelectorAll('.mcq-opts button').forEach(b=>b.classList.remove('selected'));
        btn.classList.add('selected'); items[i].picked = oi;
      });
    });
  });
}
function checkMCQ(containerId, items, scoreId){
  const el = document.getElementById(containerId); let score=0;
  el.querySelectorAll('.mcq-item').forEach((itemEl,i)=>{
    const it = items[i];
    itemEl.querySelectorAll('.mcq-opts button').forEach((btn,oi)=>{
      btn.classList.remove('correct','wrong');
      if(oi===it.a) btn.classList.add('correct'); else if(it.picked===oi) btn.classList.add('wrong');
    });
    if(it.picked===it.a) score++;
  });
  document.getElementById(scoreId).textContent = `Score: ${score} / ${items.length}`;
}

