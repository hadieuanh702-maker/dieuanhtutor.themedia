<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Unit 8 · The Media Vocabulary</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#141414; --paper:#F1EFE9; --card:#FFFFFF;
    --red:#E4142D; --red-pale:#FCE1E4;
    --blue:#1C4FA0; --blue-pale:#E4ECF8;
    --gold:#F2B705; --gold-pale:#FDF1CC;
    --ink-soft:#4B4B4B;
    --shadow:0 10px 24px rgba(20,20,20,.14);
  }
  *{box-sizing:border-box;}
  body{
    margin:0; min-height:100vh; color:var(--ink); font-family:'Be Vietnam Pro',sans-serif;
    background:
      repeating-linear-gradient(90deg, rgba(20,20,20,.025) 0 1px, transparent 1px 3px),
      var(--paper);
  }
  .display{font-family:'Anton',sans-serif; letter-spacing:.02em; text-transform:uppercase;}
  .mono{font-family:'DM Mono',monospace;}
  ::selection{background:var(--gold); color:var(--ink);}

  .ticker{background:var(--ink); color:var(--gold); font-family:'DM Mono',monospace; font-size:12px; padding:6px 0; overflow:hidden; white-space:nowrap;}
  .ticker span{display:inline-block; padding-left:100%; animation:tick 26s linear infinite;}
  @keyframes tick{0%{transform:translateX(0);} 100%{transform:translateX(-100%);}}

  .hero{max-width:1100px; margin:22px auto 0; padding:0 16px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;}
  .hero-badge{display:inline-flex; align-items:center; gap:8px; background:var(--red); color:#fff; font-family:'Anton',sans-serif; font-size:12.5px; letter-spacing:.06em; padding:6px 14px; border-radius:4px;}
  .hero h1{font-family:'Anton',sans-serif; font-size:clamp(32px,6vw,54px); margin:10px 0 6px; line-height:.95; text-transform:uppercase;}
  .hero p{color:var(--ink-soft); font-size:15px; max-width:560px; margin:0;}
  .hero-emoji{font-size:42px;}

  nav.tabs{max-width:1100px; margin:22px auto 0; padding:0 16px; display:flex; gap:14px; flex-wrap:wrap;}
  nav.tabs button{
    flex:1; min-width:220px; font-family:'Anton',sans-serif; font-size:18px; letter-spacing:.03em;
    padding:15px 20px; border:none; cursor:pointer; background:var(--card); color:var(--ink-soft);
    box-shadow:var(--shadow); display:flex; align-items:center; justify-content:center; gap:8px; transition:.15s;
    text-transform:uppercase; clip-path:polygon(0 0,100% 0,96% 100%,0% 100%);
  }
  nav.tabs button .num{width:24px;height:24px;border-radius:50%; background:var(--blue-pale); color:var(--blue); display:flex; align-items:center; justify-content:center; font-family:'DM Mono',monospace; font-size:12px;}
  nav.tabs button.active{background:var(--red); color:#fff;}
  nav.tabs button.active .num{background:rgba(255,255,255,.25); color:#fff;}
  nav.tabs button:not(.active):hover{background:var(--red-pale);}

  main{max-width:1100px; margin:24px auto 60px; padding:0 16px;}
  .view{display:none;} .view.active{display:block; animation:fade .3s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:none;}}

  section.block{margin-bottom:36px;}
  .block-head{display:flex; align-items:center; gap:12px; margin-bottom:6px;}
  .block-icon{width:40px;height:40px;border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:19px; background:var(--blk-color,var(--red)); flex-shrink:0;}
  .block-title{font-family:'Anton',sans-serif; font-size:23px; letter-spacing:.02em; text-transform:uppercase;}
  .block-desc{color:var(--ink-soft); font-size:13.5px; margin:0 0 16px 52px;}

  .chips{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;}
  .chip{font-family:'Anton',sans-serif; font-size:13px; letter-spacing:.02em; padding:7px 15px; border:2px solid var(--ink); background:#fff; cursor:pointer; text-transform:uppercase;}
  .chip.active{background:var(--ink); color:var(--gold);}
  .chip:hover:not(.active){background:var(--gold-pale);}

  .grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:16px;}
  .card{perspective:1200px; height:200px; cursor:pointer;}
  .card-inner{position:relative; width:100%; height:100%; transition:transform .5s cubic-bezier(.4,.2,.2,1); transform-style:preserve-3d;}
  .card.flip .card-inner{transform:rotateY(180deg);}
  .face{position:absolute; inset:0; backface-visibility:hidden; border-radius:6px; padding:14px 16px; display:flex; flex-direction:column; box-shadow:0 3px 10px rgba(20,20,20,.12);}
  .front{background:#fff; border:2px solid var(--ink); justify-content:space-between;}
  .front .ico{font-size:22px;}
  .front .exq{font-size:13px; line-height:1.5; margin-top:6px; color:var(--ink); flex:1;}
  .front .exq b{color:var(--red); text-decoration:underline; text-decoration-style:dotted;}
  .front .tap{margin-top:auto; font-size:10px; color:var(--blue); letter-spacing:.03em; font-family:'DM Mono',monospace;}
  .back{background:var(--ink); color:#fff; transform:rotateY(180deg); justify-content:center; gap:6px;}
  .back .w{font-family:'Anton',sans-serif; font-size:22px; color:var(--gold); text-transform:uppercase;}
  .back .pos{font-size:11px; color:#ccc; font-style:italic; margin-bottom:4px;}
  .back .vi{font-weight:700; font-size:13.5px;}
  .back .def{font-size:11.5px; color:#ddd; font-style:italic;}

  table.ref{width:100%; border-collapse:collapse; font-size:13.5px;}
  table.ref th{text-align:left; font-family:'Anton',sans-serif; font-size:12.5px; letter-spacing:.02em; background:var(--ink); color:var(--gold); padding:8px 10px; text-transform:uppercase;}
  table.ref td{padding:8px 10px; border-bottom:1px solid #ddd; vertical-align:top;}
  table.ref tr:nth-child(even) td{background:#fafaf8;}
  .kw{color:var(--red); font-weight:700;}

  .practice-hero{background:var(--ink); border-radius:6px; padding:24px 28px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden;}
  .practice-hero::before{content:"ON AIR"; position:absolute; right:-10px; top:-10px; font-family:'Anton',sans-serif; font-size:70px; color:rgba(228,20,45,.12);}
  .practice-hero h2{font-family:'Anton',sans-serif; font-size:26px; margin:0 0 4px; letter-spacing:.03em; text-transform:uppercase;}
  .practice-hero p{margin:0; opacity:.85; font-size:13.5px;}
  .jumpnav{display:flex; gap:9px; flex-wrap:wrap; margin-bottom:24px; position:sticky; top:8px; z-index:5;}
  .jumpnav a{font-family:'Anton',sans-serif; font-size:13px; background:var(--card); border:2px solid var(--ink); color:var(--ink); padding:7px 14px; text-decoration:none; box-shadow:var(--shadow);}
  .jumpnav a:hover{background:var(--gold-pale);}
  .psec{background:var(--card); border-radius:6px; padding:24px 26px; box-shadow:var(--shadow); margin-bottom:26px; scroll-margin-top:66px; border-left:5px solid var(--red);}
  .psec-head{display:flex; align-items:center; gap:12px; margin-bottom:6px;}
  .psec-icon{width:38px;height:38px; display:flex; align-items:center; justify-content:center; font-size:18px; background:var(--sec-color,var(--red)); color:#fff; font-family:'Anton',sans-serif;}
  .psec-title{font-family:'Anton',sans-serif; font-size:19px; letter-spacing:.02em; text-transform:uppercase;}
  .psec-instr{color:var(--ink-soft); font-size:13px; margin:0 0 16px 50px;}

  .bank{display:flex; flex-wrap:wrap; gap:8px; margin:0 0 16px; background:var(--gold-pale); border:2px dashed var(--gold); border-radius:8px; padding:12px;}
  .bank span{font-family:'DM Mono',monospace; font-size:12px; background:#fff; border:1px solid #ecd68a; padding:4px 10px; border-radius:5px;}

  .prow{display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:10px 4px; border-bottom:1px dashed #ddd; font-size:14px;}
  .prow .qn{font-family:'DM Mono',monospace; font-weight:700; color:var(--red); min-width:26px;}
  .prow input{font-family:'DM Mono',monospace; border:none; border-bottom:2px solid var(--ink); background:transparent; padding:4px 6px; font-size:13.5px; outline:none; min-width:120px; flex:1;}
  .prow input.correct{border-color:#2f9e4f; color:#0a7d3a;} .prow input.incorrect{border-color:var(--red); color:var(--red);}
  .prow .capw{font-family:'DM Mono',monospace; font-size:10.5px; background:var(--blue-pale); border:1px solid var(--blue); color:var(--blue); padding:2px 8px; border-radius:4px;}
  .prow .wrongw{font-family:'DM Mono',monospace; font-size:12px; background:#fff; border:1px solid var(--red); color:var(--red); text-decoration:line-through; padding:2px 8px; border-radius:4px;}
  .prow .reveal{font-size:11.5px; color:#0a7d3a; font-style:italic; display:none; width:100%;}

  .mcq-item{margin-bottom:14px; padding:12px 14px; background:var(--blue-pale); border-radius:8px;}
  .mcq-q{font-size:14px; margin-bottom:9px; line-height:1.5;}
  .mcq-q .qn{font-family:'DM Mono',monospace; font-weight:700; color:var(--blue); margin-right:6px;}
  .mcq-opts{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px;}
  .mcq-opts button{text-align:left; font-size:13px; padding:8px 11px; border:2px solid #fff; background:#fff; border-radius:6px; cursor:pointer; font-family:inherit;}
  .mcq-opts button.selected{background:#d8d8d8; border-color:var(--ink);}
  .mcq-opts button.correct{background:#d4f2dc; border-color:#2f9e4f;}
  .mcq-opts button.wrong{background:#ffd6db; border-color:var(--red);}

  .checkbar{display:flex; align-items:center; gap:16px; margin-top:14px; flex-wrap:wrap;}
  .check-btn{font-family:'Anton',sans-serif; font-size:14px; letter-spacing:.03em; background:var(--red); color:#fff; border:none; padding:10px 20px; border-radius:4px; cursor:pointer; text-transform:uppercase;}
  .result-tag{font-family:'DM Mono',monospace; font-size:13px; color:var(--ink-soft);}

  footer{text-align:center; color:var(--ink-soft); font-size:12px; padding:20px 0 50px;}
  @media(max-width:640px){
    .mcq-opts{grid-template-columns:1fr;}
    .block-desc, .psec-instr{margin-left:0;}
    .psec{padding:18px;}
  }
  :focus-visible{outline:3px solid var(--blue); outline-offset:2px;}
</style>
</head>
