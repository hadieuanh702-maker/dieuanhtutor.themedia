<script>
/* ============ VOCAB DATA ============ */
const VOCAB = [
  {en:"deny",pos:"v",icon:"🙅",cat:"opinions",vi:"phủ nhận",def:"nói rằng điều gì đó không đúng sự thật",ex:"A spokesman <b>denied</b> that the company had acted irresponsibly."},
  {en:"refuse",pos:"v",icon:"🚫",cat:"opinions",vi:"từ chối",def:"nói rằng bạn sẽ không làm/chấp nhận điều gì",ex:"I asked him to apologise, but he <b>refused</b>."},
  {en:"agree",pos:"v",icon:"🤝",cat:"opinions",vi:"đồng ý",def:"có cùng quan điểm với ai đó",ex:"Doreen thought the house was too small, and Jim <b>agreed</b>."},
  {en:"accept",pos:"v",icon:"✅",cat:"opinions",vi:"chấp nhận, thừa nhận",def:"công nhận rằng điều gì đó là đúng, công bằng",ex:"Most scientists <b>accept</b> that climate change is linked to pollution."},
  {en:"headline",pos:"n",icon:"📰",cat:"print",vi:"tiêu đề (in đậm, cỡ lớn)",def:"tựa đề của một bản tin báo, in chữ to",ex:"The front page was taken up with the <b>headline</b> 'YOU LIAR!'."},
  {en:"heading",pos:"n",icon:"📝",cat:"print",vi:"tiêu đề (đầu trang/đoạn văn)",def:"tựa đề ở đầu một trang hoặc đoạn viết",ex:"If you look at the <b>heading</b>, it'll tell you what the paragraph is about."},
  {en:"feature",pos:"n",icon:"⭐",cat:"print",vi:"bài viết/chuyên mục đặc biệt",def:"bài báo hoặc phần chương trình tập trung vào một chủ đề",ex:"This week we've got a special <b>feature</b> on new children's books."},
  {en:"article",pos:"n",icon:"📄",cat:"print",vi:"bài báo",def:"một bài viết trên báo hoặc tạp chí",ex:"He has written several <b>articles</b> for The Times."},
  {en:"tabloid",pos:"n",icon:"🗞️",cat:"print",vi:"báo lá cải",def:"báo khổ nhỏ, ít tin nghiêm túc",ex:"I don't know why you waste your money on that <b>tabloid</b>."},
  {en:"broadsheet",pos:"n",icon:"📃",cat:"print",vi:"báo khổ lớn (nghiêm túc)",def:"báo nghiêm túc, in trên khổ giấy lớn",ex:"The Daily Telegraph and The Guardian are both <b>broadsheets</b>."},
  {en:"press",pos:"n",icon:"🖨️",cat:"print",vi:"báo chí (nói chung)",def:"báo và tạp chí tin tức, hoặc giới nhà báo",ex:"She has been criticised in the <b>press</b> for not speaking out."},
  {en:"media",pos:"n",icon:"📡",cat:"print",vi:"truyền thông",def:"đài, TV, báo, Internet, tạp chí nói chung",ex:"The story has been widely reported in the <b>media</b>."},
  {en:"talk show",pos:"n",icon:"🎙️",cat:"broadcast",vi:"chương trình trò chuyện",def:"chương trình người nổi tiếng nói về bản thân/công việc",ex:"Did you see Johnny Depp on that <b>talk show</b> last night?"},
  {en:"quiz show",pos:"n",icon:"❓",cat:"broadcast",vi:"chương trình đố vui có thưởng",def:"chương trình trả lời câu hỏi để giành giải thưởng",ex:"Maybe you should go on a <b>quiz show</b>."},
  {en:"game show",pos:"n",icon:"🎮",cat:"broadcast",vi:"chương trình trò chơi truyền hình",def:"chương trình chơi trò chơi để giành giải thưởng",ex:"Bruce Forsyth used to host a <b>game show</b> called The Generation Game."},
  {en:"programme",pos:"n",icon:"📺",cat:"broadcast",vi:"chương trình (TV/radio)",def:"một buổi phát sóng truyền hình hoặc radio",ex:"More people watch the news than any other <b>programme</b>."},
  {en:"program",pos:"n",icon:"💻",cat:"broadcast",vi:"chương trình (máy tính)",def:"chuỗi lệnh khiến máy tính thực hiện việc gì",ex:"I'm getting a new word processing <b>program</b> for my laptop."},
  {en:"channel",pos:"n",icon:"📡",cat:"broadcast",vi:"kênh (truyền hình)",def:"đài truyền hình và các chương trình nó phát sóng",ex:"What's on the other <b>channel</b>?"},
  {en:"broadcast",pos:"n",icon:"📶",cat:"broadcast",vi:"buổi phát sóng",def:"một chương trình được phát sóng",ex:"We usually watch Channel 5's main news <b>broadcast</b> in the evening."},
  {en:"bulletin",pos:"n",icon:"🕐",cat:"broadcast",vi:"bản tin ngắn",def:"một bản tin phát sóng ngắn",ex:"There's a two-minute news <b>bulletin</b> on at eleven o'clock."},
  {en:"newsflash",pos:"n",icon:"⚡",cat:"broadcast",vi:"tin nóng, tin khẩn",def:"tin tức quan trọng phát xen giữa chương trình",ex:"We interrupt this programme to bring you a <b>newsflash</b>."},
  {en:"announcer",pos:"n",icon:"🎤",cat:"people",vi:"người dẫn chương trình (giới thiệu)",def:"người thông báo thông tin giữa các chương trình",ex:"The <b>announcer</b> just said the football match is on instead."},
  {en:"commentator",pos:"n",icon:"🗣️",cat:"people",vi:"bình luận viên",def:"người mô tả một sự kiện khi nó đang diễn ra",ex:"I'd love to be a sports <b>commentator</b>."},
  {en:"journalist",pos:"n",icon:"🖋️",cat:"people",vi:"nhà báo",def:"người có nghề đưa tin",ex:"Enid works as a <b>journalist</b> for the local newspaper."},
  {en:"columnist",pos:"n",icon:"✍️",cat:"people",vi:"người viết chuyên mục",def:"nhà báo viết loạt bài định kỳ cho một tờ báo",ex:"As a <b>columnist</b>, I'm allowed to express my opinion."},
];

const PHRASALS = [
  {en:"bring up",icon:"💡",vi:"bắt đầu đề cập một chủ đề",ex:"She <b>brought up</b> the topic of pay rises at the meeting."},
  {en:"come on",icon:"▶️",vi:"bắt đầu được phát sóng",ex:"Shh, the news is about to <b>come on</b>!"},
  {en:"come out",icon:"📖",vi:"được xuất bản",ex:"Her new novel <b>comes out</b> next month."},
  {en:"fill in",icon:"📝",vi:"điền thông tin vào (biểu mẫu)",ex:"Please <b>fill in</b> this form before your interview."},
  {en:"flick through",icon:"📖",vi:"lướt xem nhanh (tạp chí...)",ex:"I <b>flicked through</b> the magazine while waiting."},
  {en:"go into",icon:"🔍",vi:"đi sâu vào chi tiết",ex:"The report didn't <b>go into</b> the causes of the problem."},
  {en:"hand out",icon:"🤲",vi:"phát cho mọi người",ex:"They were <b>handing out</b> free samples outside the shop."},
  {en:"look up",icon:"🔎",vi:"tra cứu thông tin",ex:"I'll <b>look up</b> the address in the phone book."},
  {en:"make out",icon:"🤔",vi:"giả vờ là thật; nghe/nhìn/hiểu một cách khó khăn",ex:"He <b>made out</b> that he'd never heard of her."},
  {en:"make up",icon:"📚",vi:"bịa ra (câu chuyện, lý do)",ex:"She <b>made up</b> an excuse for being late."},
